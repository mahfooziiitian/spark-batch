# JupyterLab + PySpark notebook image
#
# Build (done automatically by docker compose):
#   docker compose build notebook
#
# Extends the official Spark image with JupyterLab so notebooks can connect
# directly to the standalone cluster started by docker-compose.yml.

FROM apache/spark:3.5.0-python3

USER root

RUN pip install --no-cache-dir \
      "pyarrow>=4.0.0"  \
      "pandas>=1.3.0"   \
      "numpy>=1.21.0"   \
      "jupyterlab>=4.0" \
      "ipykernel>=6.0"  \
    && ln -s "$(which python3)" /usr/local/bin/python

ENV PYSPARK_PYTHON=python3 \
    PYSPARK_DRIVER_PYTHON=python3

# Expose PySpark to plain `python3` and Jupyter kernels (not only spark-submit).
# py4j version matches Spark 3.5.x — update if changing the base image tag.
ENV PYTHONPATH="${SPARK_HOME}/python:${SPARK_HOME}/python/lib/py4j-0.10.9.7-src.zip"

RUN mkdir -p /notebooks /home/spark && chown -R 185:185 /notebooks /home/spark

USER spark

WORKDIR /notebooks

EXPOSE 8888

# JUPYTER_TOKEN env var is read automatically by Jupyter at startup.
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--no-browser", \
     "--notebook-dir=/notebooks"]

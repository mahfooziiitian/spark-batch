# Copy to .env and customize as needed. Loaded automatically via python-dotenv
# in pys_html.config (does not override variables already set in the shell).

# Spark master URL (defaults to local[*])
# SPARK_MASTER=local[*]

# Explicit JAVA_HOME override — only needed if auto-detection (JAVA_HOME already
# set, or "java" resolvable on PATH) picks the wrong JDK. PySpark 4 requires Java 17+.
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Base directory for example input/output data (defaults to <project_root>/data)
# DATA_HOME=/tmp/pys_html_data

# Log level for the pys_html library (DEBUG, INFO, WARNING, ERROR)
# PYS_HTML_LOG_LEVEL=INFO

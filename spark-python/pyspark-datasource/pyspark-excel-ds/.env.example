# Copy to .env and adjust as needed — .env is git-ignored, .env.example is not.
# All variables are optional; sensible fallbacks are used when unset.

# JDK home used by PySpark (falls back to JAVA_HOME_17, then existing JAVA_HOME).
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk

# Spark master URL. Defaults to local[*] when unset.
# SPARK_MASTER=local[*]

# Root directory for generated sample data, warehouse, and metastore_db.
# Defaults to <project_root>/data when unset.
# DATA_HOME=/tmp/pys-excel-data

# Spark Connect endpoint used by get_spark_connect(). Defaults to sc://localhost:15002.
# SPARK_CONNECT_URL=sc://localhost:15002

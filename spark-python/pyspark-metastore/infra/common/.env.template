# ── Spark Core ──
SPARK_MASTER=local[*]
SPARK_WAREHOUSE=/tmp/spark-warehouse
JAVA_HOME_11=/usr/lib/jvm/java-11-openjdk-amd64
JAVA_HOME_17=/usr/lib/jvm/java-17-openjdk-amd64

# ── PySpark ──
PYSPARK_PYTHON=python3
PYSPARK_DRIVER_PYTHON=python3
SPARK_LOCAL_IP=127.0.0.1

# ── Hive Metastore ──
HIVE_METASTORE_URI=thrift://localhost:9083
HIVE_METASTORE_DB_TYPE=postgres
HIVE_METASTORE_DB_HOST=localhost
HIVE_METASTORE_DB_PORT=5432
HIVE_METASTORE_DB_NAME=metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=hive

# ── JDBC Catalog ──
JDBC_URL=jdbc:postgresql://localhost:5432/appdb
JDBC_DRIVER=org.postgresql.Driver
JDBC_USER=appuser
JDBC_PASSWORD=apppassword

# ── AWS Glue ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GLUE_WAREHOUSE=s3://my-bucket/warehouse

# ── Iceberg REST Catalog ──
REST_CATALOG_URI=http://localhost:8181
REST_CATALOG_WAREHOUSE=s3://my-bucket/iceberg
REST_CATALOG_TOKEN=

# ── Hadoop ──
HADOOP_WAREHOUSE=hdfs://namenode:8020/warehouse

# ── Databricks Unity Catalog ──
DBX_WORKSPACE_URL=https://your-workspace.cloud.databricks.com
UC_CATALOG=main
UC_SCHEMA=default

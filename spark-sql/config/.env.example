# FIRST-TIME SETUP (after cloning this repo): cp config/.env.example .env
# then edit .env in the repo root and fill in real values. .env (repo root) is gitignored;
# this config/.env.example template is tracked.
#
# This is the single-workspace fallback: dbx_mcp (which is not DAB_TARGET-aware) always
# reads these values, and the REST/SDK deploy path uses them whenever a value isn't
# overridden in .env.$(DAB_TARGET). Every value here (including DATABRICKS_HOST/TOKEN/
# WAREHOUSE_NAME) DOES vary per real environment (see databricks.yml) -- if you deploy to
# more than one workspace, set the real per-environment values in config/.env.dev /
# config/.env.staging / config/.env.prod instead (or in addition), and leave
# this file pointed at whichever single workspace dbx_mcp/local ad-hoc runs should default to.

DATABRICKS_HOST=
DATABRICKS_TOKEN=
# SQL warehouse to attach dashboards to. For local runs set the NAME here and the
# deploy resolves its ID automatically (get warehouse id by name); DATABRICKS_WAREHOUSE_ID
# is populated at runtime with the resolved value.
DATABRICKS_WAREHOUSE_NAME=
DATABRICKS_WAREHOUSE_ID=
# BUNDLE_VAR_warehouse_name drives the bundle's warehouse_name variable for `make dab-*`
# (see variables/variables.yml) -- keep it in sync with DATABRICKS_WAREHOUSE_NAME above.
BUNDLE_VAR_warehouse_name=
# DATABRICKS_CONFIG_PROFILE and TEMPLATE_KEY_VALUES commonly also vary per DAB_TARGET
# (dev/staging/prod) -- see config/.env.dev / config/.env.staging /
# config/.env.prod. The Makefile auto-loads .env.$(DAB_TARGET) after this file, so
# any value set there overrides what's set here for that target only.
#
# ENV_SHORT/ENV_LONG/AUDIT_SCHEMA/DATABRICKS_DASHBOARD_PARENT_PATH (read by src/dashboard/rest/ and
# src/dashboard/sdk/ deploy scripts, via EnvConfig in src/dashboard/model/env.py) also vary
# per environment -- see the same config/.env.<target>.example files.
#
# Note: the local definitions root scanned by deploy-dashboard/list-dashboards is a fixed
# constant (dashboard.constants.DASHBOARD_LOCATION = "./definitions"), not an env var --
# it never changes, so it isn't set here.

# DASHBOARD_FILE/DASHBOARD_NAME are no longer environment variables -- deploy-dashboard
# takes them as CLI options instead, since they're ad-hoc, per-invocation selectors:
#   uv run deploy-dashboard --file definitions/path/to/file.lvdash.json
#   uv run deploy-dashboard --name access_management_dashboard
# or via make: `make deploy-file FILE=...` / `make deploy-name NAME=...`. Leaving both
# unset deploys every *.lvdash.json under DASHBOARD_LOCATION.


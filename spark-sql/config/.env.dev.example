# Environment-specific overrides for DAB_TARGET=dev, auto-loaded by the Makefile
# after the generic .env (see the top of the Makefile for load order).
#
# FIRST-TIME SETUP (after cloning this repo):
#   cp config/.env.dev .env.dev
#   # then edit .env.dev in the repo root and fill in real values.
# .env.dev (repo root) is gitignored; this config/.env.dev template is tracked.
#
# Put any value here that differs for dev specifically -- DATABRICKS_HOST/TOKEN/
# WAREHOUSE_NAME genuinely do vary per environment (see databricks.yml), so they're
# set here too, not just DATABRICKS_CONFIG_PROFILE/TEMPLATE_KEY_VALUES. A line left
# commented out here falls back to whatever's set in the generic .env instead
# (see config/.env.example -> copy to .env in the repo root).

# Named profile from ~/.databrickscfg for the dev workspace. If set, DATABRICKS_HOST/TOKEN
# below are resolved from the profile automatically and can be left blank.
# Note: `make dab-*` no longer pins host/warehouse in databricks.yml -- it's driven from
# here too. DATABRICKS_HOST/TOKEN/PROFILE are picked up by the Databricks CLI's native env
# auth resolution (no `workspace.host` in databricks.yml); BUNDLE_VAR_warehouse_name below
# (kept in sync with DATABRICKS_WAREHOUSE_NAME) is the Databricks CLI's native mechanism for
# setting the bundle's `${var.warehouse_name}`, overriding the `variables.warehouse_name`
# default. This lets the same bundle deploy to any workspace.
DATABRICKS_CONFIG_PROFILE=dev

# dev workspace host/warehouse (databricks.yml no longer pins these per target) -- only needed
# if NOT using DATABRICKS_CONFIG_PROFILE above.
DATABRICKS_HOST=https://acuity-ozd.cloud.databricks.com
# DATABRICKS_TOKEN=   (uncomment and set only if overriding the token for this target specifically)
DATABRICKS_WAREHOUSE_NAME=Starter Endpoint
# Drives the bundle's warehouse_name variable for `make dab-*` (kept in sync with the value above).
BUNDLE_VAR_warehouse_name=Starter Endpoint

# dashboard_parent_path/environment used to be hardcoded per target in databricks.yml's
# targets.dev block -- now driven from here instead (see variables/variables.yml).
BUNDLE_VAR_dashboard_parent_path=/Workspace/dashboards/dev
BUNDLE_VAR_environment=dev

# dev is a separate workspace from staging/prod (see databricks.yml) -- verify the
# mgmt/metadata catalog and schema names actually exist there before deploying;
# these are placeholders copied from staging/prod and may need to differ.
TEMPLATE_KEY_VALUES={"mgmt_catalog": "mgmt_stg","mgmt_schema": "metadata", "system_datalog": "system_datalog"}

# Read by the REST/SDK deploy scripts (src/dashboard/rest/deploy_dashboard.py,
# src/dashboard/sdk/deploy_dashboard.py) via EnvConfig -- used to tag/label the deployed
# dashboard and as the "$$pg_schema" template default when TEMPLATE_KEY_VALUES omits it.
ENV_SHORT=dev
ENV_LONG=development
# Placeholder -- verify the actual audit schema name for this workspace before deploying.
AUDIT_SCHEMA=audit
# Workspace destination folder for the REST/SDK deploy path (mirrors
# BUNDLE_VAR_dashboard_parent_path above, kept in sync for the DAB path).
DATABRICKS_DASHBOARD_PARENT_PATH=/Workspace/dashboards/dev


